{
  "openapi": "3.1.0",
  "info": {
    "title": "CargaWise API",
    "version": "0.1.0"
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-cw_session"
      },
      "mobileBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "def-0": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "intent"
        ],
        "properties": {
          "email": {
            "format": "email",
            "maxLength": 254,
            "type": "string"
          },
          "intent": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "register"
                ]
              },
              {
                "type": "string",
                "enum": [
                  "login"
                ]
              }
            ]
          }
        },
        "title": "EmailChallenge"
      },
      "def-1": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "challengeId",
          "code"
        ],
        "properties": {
          "challengeId": {
            "format": "uuid",
            "type": "string"
          },
          "code": {
            "pattern": "^[0-9]{6}$",
            "type": "string"
          }
        },
        "title": "EmailVerification"
      }
    }
  },
  "paths": {
    "/api/v1/health/live": {
      "get": {
        "operationId": "liveness",
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "operationId": "readiness",
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "additionalProperties": false,
                      "type": "object",
                      "required": [
                        "code",
                        "message",
                        "fieldErrors",
                        "requestId",
                        "retryable"
                      ],
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "fieldErrors": {
                          "type": "array",
                          "items": {
                            "additionalProperties": false,
                            "type": "object",
                            "required": [
                              "field",
                              "message"
                            ],
                            "properties": {
                              "field": {
                                "type": "string"
                              },
                              "message": {
                                "type": "string"
                              }
                            }
                          }
                        },
                        "requestId": {
                          "type": "string"
                        },
                        "retryable": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "/"
    }
  ]
}
