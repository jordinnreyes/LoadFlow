# Placeholders only. Generate local credentials with npm run local:env after local:start.
PUBLIC_APP_ORIGIN=http://127.0.0.1:3001
# Con Vite, usar PUBLIC_APP_ORIGIN=http://127.0.0.1:5173 y conservar los callbacks registrados:
# OAUTH_CALLBACK_ORIGIN=http://127.0.0.1:3001
PORT=3001
DATABASE_URL=postgresql://cw_runtime:REPLACE_LOCAL_PASSWORD@127.0.0.1:54322/postgres
MIGRATION_DATABASE_URL=postgresql://cw_migrator:REPLACE_LOCAL_PASSWORD@127.0.0.1:54322/postgres
IDENTITY_DATABASE_URL=postgresql://cw_identity:REPLACE_LOCAL_PASSWORD@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=REPLACE_LOCAL_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_LOCAL_SERVER_ONLY_KEY
CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
# No Google production credentials or OpenAI key are required in F0.
# F2, separate development OAuth client; do not reuse Supabase identity credentials.
# Enable Google Calendar API, redirect: http://127.0.0.1:3001/api/v1/calendar/callback
CALENDAR_CLIENT_ID=
CALENDAR_CLIENT_SECRET=
# Opt-in local tras autorizar consumo. Conserva el presupuesto y los derechos de F5.
ESTIMATES_LOCAL_ENABLED=false
OPENAI_API_KEY=
