  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023"], "module": "NodeNext",
    "moduleResolution": "NodeNext", "strict": true, "noEmit": true,
    "esModuleInterop": true, "skipLibCheck": true, "types": ["node"],
    "resolveJsonModule": true
